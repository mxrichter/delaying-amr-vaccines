<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<om:scenario xmlns:om="http://openmalaria.org/schema/scenario_45" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="example" schemaVersion="45" xsi:schemaLocation="http://openmalaria.org/schema/scenario_45 scenario_45.xsd">

<!-- DEMOGRAPHY -->
<demography maximumAgeYrs="90" name="Zambia 2010 census_Southern province " popSize="@population_size@">
  <ageGroup lowerbound="0">
    <group poppercent="3.6" upperbound="1"/>
    <group poppercent="14.1" upperbound="5"/>
    <group poppercent="14.8" upperbound="10"/>
    <group poppercent="13.6" upperbound="15"/>
    <group poppercent="11.4" upperbound="20"/>
    <group poppercent="8.9" upperbound="25"/>
    <group poppercent="8" upperbound="30"/>
    <group poppercent="6.4" upperbound="35"/>
    <group poppercent="5.2" upperbound="40"/>
    <group poppercent="3.6" upperbound="45"/>
    <group poppercent="2.8" upperbound="50"/>
    <group poppercent="2.2" upperbound="55"/>
    <group poppercent="1.5" upperbound="60"/>
    <group poppercent="1.3" upperbound="65"/>
    <group poppercent="0.9" upperbound="70"/>
    <group poppercent="0.7" upperbound="75"/>
    <group poppercent="0.5" upperbound="80"/>
    <group poppercent="0.3" upperbound="85"/>
    <group poppercent="0.1" upperbound="90"/>
  </ageGroup>
</demography>

<!-- MONITORING -->
<monitoring name="monthly surveys" startDate="1990-01-01">
  <SurveyOptions>
    <option name="nHost" value="true"/>
    <option name="nInfect" value="true"/>
    <option name="nExpectd" value="true"/>
    <option name="nPatent" value="true"/>
    <option name="nSevere" value="true"/>
    <option name="nTreatments1" value="true"/>
    <option name="nTreatments2" value="true"/>
    <option name="nTreatments3" value="true"/>
    <option name="simulatedEIR" value="true"/>
    <option name="inputEIR" value="true"/>
    <option name="nUncomp" value="true"/>
    <option name="nEPIVaccinations" value="true"/>
    <option name="nMassVaccinations" value="true"/>
    <option name="nInfectByGenotype"/>
    <option name="nPatentByGenotype"/>
    <option name="nTransmit"/>
    <option name="nHostDrugConcNonZero"/>
    <option name="innoculationsPerAgeGroup"/>
  </SurveyOptions>
  <surveys diagnostic="microscopy">
    <surveyTime repeatStep="5d" repeatEnd="@end_date@">@init_date@</surveyTime> 
  </surveys>
  <ageGroup lowerbound="0">
    @agegroup_groups@
    <group upperbound="100"/>
  </ageGroup>
  <cohorts>
    <subPop id="treat_liver" number="1"/>
  </cohorts>
</monitoring>

<!-- INTERVENTIONS -->
<interventions name="GVI example">
  <human>
	
	  <!-- Vaccine -->
	  <component id="vaccine" name="vaccine">
		  <PEV>
        @vaccine_decay@
        <efficacyB value="10.0"/>   
        <phenotype name="sensitive">
          <restriction onLocus="x" toAllele="sensitive"/>
          @vaccine_efficacy_sensitive@ 
        </phenotype>
        <phenotype name="resistant">
          <restriction onLocus="x" toAllele="resistant"/>
          @vaccine_efficacy_resistant@ 
        </phenotype>
      </PEV>
      @cohort_removal@
		</component>

    <!-- Liver stage treatment: protect from reinfection during 30d days -->
	  <component id="treat_liver">
		  <treatSimple durationLiver="7t" durationBlood="0"/>
      <subPopRemoval afterYears="0.0822"/> <!-- part of the cohort for 30 days and protect from reinfection during that time-->
    </component>
      
    <!-- Blood stage treatment: using ACT_R after resistance is introduced -->
    <component id="treat_blood">
      <treatPKPD schedule="ACT_R" dosage="ACT_R"/> <!-- ACT is drug we want evalute TF in this case -->
    </component>
        
    <!-- artifical HS to give drug we want evalute ( deployed every 40 days see below) -->
    <component id="MSAT">
      <decisionTree>
        <!-- fevers (counted with healthsystem memory) -->
        <fever lookBack="5d">
          <positive>
            <diagnostic diagnostic="microscopy">
      		    <positive>
        	      <deploy component="treat_liver"/>
                <deploy component="treat_blood"/>
      	      </positive>
      	      <negative>
				        <noTreatment/>
      	      </negative>
   	        </diagnostic>
          </positive>
          <negative>
            <noTreatment/>
          </negative>
        </fever>
      </decisionTree>
    </component>
        
    <!-- artifical HS to general population -->
    <component id="HS">
      <decisionTree>
        <fever lookBack="5d">
          <positive>
            <random>
              <outcome p="@access@">
                <treatSimple durationLiver="0" durationBlood="1t"/>
              </outcome>
              <outcome p="@access_complement@">
                <noTreatment/>
              </outcome>
            </random>
          </positive>
          <negative>
            <noTreatment/>
          </negative>
        </fever>
      </decisionTree>
    </component>
      
	  @vaccine_deployment@
	      
    <!-- deploy the artifical HS to give drug we want evalute (every 40 days) -->
    <deployment>
      <component id="MSAT"/>
      <timed>
        <deploy coverage="1.0" time="@start_date@" repeatStep="0.11y" repeatEnd="@end_date@"/>
      </timed>
    </deployment>
      
      <!-- deploy the artifical HS to whole population (excpet those who received drug we want evaluate (part of treat liver cohort)) -->
    <deployment>
      <component id="HS"/>
      <timed>
        <restrictToSubPop id="treat_liver" complement="true"/>
        <deploy coverage="1.0" time="@start_date@" repeatStep="5d" repeatEnd="@end_date@"/>
      </timed>
    </deployment>
      
  </human>
     
     <!-- remove the use of normal HS (all access equal to zero )-->
     <changeHS name="allow resistance">
      <timedDeployment time="@start_date@">
 	       <DecisionTree5Day name="example name">
          <pSeekOfficialCareUncomplicated1 value="0.0"/>
          <pSelfTreatUncomplicated value="0.0"/>
          <pSeekOfficialCareUncomplicated2 value="0.0"/>
          <pSeekOfficialCareSevere value="0.0"/>
          <treeUCOfficial>
           <treatSimple durationLiver="0" durationBlood="1t"/>
          </treeUCOfficial>
          <treeUCSelfTreat>
           <noTreatment/>
          </treeUCSelfTreat>
          <cureRateSevere value="1.0"/>
          <treatmentSevere>
           <clearInfections stage="blood" timesteps="1t"/>
          </treatmentSevere>
          </DecisionTree5Day>
          <CFR>
           <group lowerbound="0" value="0.09189"/>
           <group lowerbound="0.25" value="0.0810811"/>
           <group lowerbound="0.75" value="0.0648649"/>
           <group lowerbound="1.5" value="0.0689189"/>
           <group lowerbound="2.5" value="0.0675676"/>
           <group lowerbound="3.5" value="0.0297297"/>
           <group lowerbound="4.5" value="0.0459459"/>
           <group lowerbound="7.5" value="0.0945946"/>
           <group lowerbound="12.5" value="0.1243243"/>
           <group lowerbound="15" value="0.1378378"/>
          </CFR>
          <pSequelaeInpatient interpolation="none">
           <group lowerbound="0.0" value="0.0132"/>
           <group lowerbound="5.0" value="0.005"/>
          </pSequelaeInpatient>
    </timedDeployment>
  </changeHS>
</interventions>

    <!-- Specify health system for the burn in phase -->
    <healthSystem>
        <!-- The more flexible DecisionTree5Day replaces the older ImmediateOutcomes. 
        The probabilities below are greatly affected by the presence (or the absence) of a clinic or hospital on site -->
        <DecisionTree5Day name="example name">
            <pSeekOfficialCareUncomplicated1 value="@access@"/><!-- 5-day probability that a patient uncomplicated case seeks official care -->
            <pSelfTreatUncomplicated value="0.0"/><!-- 5-day probability that a patient with uncomplicated case will self-treat -->
            <pSeekOfficialCareUncomplicated2 value="@access@"/><!-- 5-day probability that a patient with recurrence seeks official care -->
            <pSeekOfficialCareSevere value="0.0"/><!-- 5-day probability that a patient with severe case seeks official care -->
            <treeUCOfficial>
              <diagnostic diagnostic="microscopy">
               <positive>
                <treatSimple durationLiver="0" durationBlood="1t"/>
                </positive>
               <negative>
                 <noTreatment/>
               </negative>
             </diagnostic>
            </treeUCOfficial>
            <treeUCSelfTreat>
                <noTreatment/>
            </treeUCSelfTreat>
            <cureRateSevere value="1.0"/>
            <treatmentSevere>
                <clearInfections stage="blood" timesteps="1t"/>
            </treatmentSevere>
        </DecisionTree5Day>
        <CFR>
            <group lowerbound="0" value="0.09189"/>
            <group lowerbound="0.25" value="0.0810811"/>
            <group lowerbound="0.75" value="0.0648649"/>
            <group lowerbound="1.5" value="0.0689189"/>
            <group lowerbound="2.5" value="0.0675676"/>
            <group lowerbound="3.5" value="0.0297297"/>
            <group lowerbound="4.5" value="0.0459459"/>
            <group lowerbound="7.5" value="0.0945946"/>
            <group lowerbound="12.5" value="0.1243243"/>
            <group lowerbound="15" value="0.1378378"/>
        </CFR>
        <pSequelaeInpatient interpolation="none">
            <group lowerbound="0.0" value="0.0132"/>
            <group lowerbound="5.0" value="0.005"/>
        </pSequelaeInpatient>
    </healthSystem>

<!-- ENTOMOLOGY -->
<entomology mode="dynamic" name="Zambia Southern province" scaledAnnualEIR="@eir@">
  <vector>      
    <anopheles mosquito="gambiae_ss_outdoor" propInfected="0.078" propInfectious="0.021">
    @seasonality@
    <mosq minInfectedThreshold="0.001">
      <mosqRestDuration value="3"/>
      <extrinsicIncubationPeriod value="11"/>
      <mosqLaidEggsSameDayProportion value="0.313"/>
      <mosqSeekingDuration value="0.33"/>
      <mosqSurvivalFeedingCycleProbability value="0.623"/>
      <availability/>
      <mosqProbBiting mean="0.95" variance="0"/>
      <mosqProbFindRestSite mean="0.95" variance="0"/>
      <mosqProbResting mean="0.99" variance="0"/>
      <mosqProbOvipositing value="0.88"/>
      <mosqHumanBloodIndex value="0.5"/>
    </mosq>
    <nonHumanHosts name="unprotectedAnimals">
      <mosqRelativeEntoAvailability value="1.0"/>
      <mosqProbBiting value="0.95"/>
      <mosqProbFindRestSite value="0.95"/>
      <mosqProbResting value="0.99"/>
    </nonHumanHosts>
  </anopheles>
	<nonHumanHosts name="unprotectedAnimals" number="1.0"/>
  </vector>
</entomology>
    
<!-- PARASITE GENETICS -->
<parasiteGenetics samplingMode="initial">
  <!-- Define name/freq/fitness of the locus/alleles defined in the drugPD code -->
  <locus name="x">
    <allele fitness="1" initialFrequency="@prevalence_sensitive@" name="sensitive"/>
    <allele fitness="1" initialFrequency="@prevalence_resistant@" name="resistant"/>
  </locus>
</parasiteGenetics>

    <!-- This diagnostic object can be used in several places, including in the monitoring section and in the NeoNatalMortality model.
    It is also possible to specify stochastic diagnostics, see: https://github.com/SwissTPH/openmalaria/wiki/Diagnostics -->
    <diagnostics>
        <diagnostic name="deterministic">
            <deterministic minDensity="40"/>
        </diagnostic>
        <diagnostic name="microscopy" units="Other">
            <stochastic dens_50="20" specificity="1"/>
        </diagnostic>
	<diagnostic name="PCR" units="Other">
      		<stochastic dens_50="2" specificity="1"/>
    	</diagnostic>
    </diagnostics>

<!--- PHARMACOLOGY -->
<pharmacology>
    <treatments>
      <schedule name="ACT">
        <medicate drug="AR" hour="0" mg="20"/>
        <medicate drug="LF" hour="0" mg="120"/>
        <medicate drug="AR" hour="8" mg="20"/>
        <medicate drug="LF" hour="8" mg="120"/>
        <medicate drug="AR" hour="24" mg="20"/>
        <medicate drug="LF" hour="24" mg="120"/>
        <medicate drug="AR" hour="36" mg="20"/>
        <medicate drug="LF" hour="36" mg="120"/>
        <medicate drug="AR" hour="48" mg="20"/>
        <medicate drug="LF" hour="48" mg="120"/>
        <medicate drug="AR" hour="60" mg="20"/>
        <medicate drug="LF" hour="60" mg="120"/>
      </schedule>
      <schedule name="ACT_R">
        <medicate drug="AR_R" hour="0" mg="20"/>
        <medicate drug="LF_R" hour="0" mg="120"/>
        <medicate drug="AR_R" hour="8" mg="20"/>
        <medicate drug="LF_R" hour="8" mg="120"/>
        <medicate drug="AR_R" hour="24" mg="20"/>
        <medicate drug="LF_R" hour="24" mg="120"/>
        <medicate drug="AR_R" hour="36" mg="20"/>
        <medicate drug="LF_R" hour="36" mg="120"/>
        <medicate drug="AR_R" hour="48" mg="20"/>
        <medicate drug="LF_R" hour="48" mg="120"/>
        <medicate drug="AR_R" hour="60" mg="20"/>
        <medicate drug="LF_R" hour="60" mg="120"/>
      </schedule>
      <dosages name="ACT">
        <bodymass lowerbound="0" dose_mult="1"/>
        <bodymass lowerbound="15" dose_mult="2"/><!-- 2 tablets -->
        <bodymass lowerbound="25" dose_mult="3"/><!-- 3 tablets -->
        <bodymass lowerbound="35" dose_mult="4"/><!-- 4 tablets. -->
      </dosages>
      <dosages name="ACT_R">
        <bodymass lowerbound="0" dose_mult="1"/>
        <bodymass lowerbound="15" dose_mult="2"/><!-- 2 tablets -->
        <bodymass lowerbound="25" dose_mult="3"/><!-- 3 tablets -->
        <bodymass lowerbound="35" dose_mult="4"/><!-- 4 tablets. -->
      </dosages>
    </treatments>
    <drugs>
      <drug abbrev="AR"><!-- Artemether, one compartment model -->
        <PD>
          <phenotype name="sensitive">
            <restriction onLocus="x" toAllele="sensitive"/>
            <max_killing_rate>@ar_mkr_sensitive@</max_killing_rate>
            <IC50 mean="0.0023" distr="lognormal" CV="0.0"/>
            <slope>4</slope>
          </phenotype>
          <phenotype name="resistant">
            <restriction onLocus="x" toAllele="resistant"/>
            <max_killing_rate>@ar_mkr_sensitive@</max_killing_rate>
            <IC50 mean="0.0023" distr="lognormal" CV="0.0"/>
            <slope>4</slope>
          </phenotype>
        </PD>
        <PK>
          <negligible_concentration>1e-17</negligible_concentration>
          <k mean="3.96"/>
          <m_exponent>0.0</m_exponent>
          <vol_dist mean="17.4" />
        </PK>
      </drug>
      <drug abbrev="LF"><!-- Lumefantrine -->
        <PD>
          <phenotype name="sensitive">
            <restriction onLocus="x" toAllele="sensitive"/>
            <max_killing_rate>3.45</max_killing_rate>
            <IC50 mean="@lf_sensitive_level@" distr="lognormal" CV="0.0"/>
            <slope>4</slope>
          </phenotype>
          <phenotype name="resistant">
            <restriction onLocus="x" toAllele="resistant"/>
            <max_killing_rate>3.45</max_killing_rate>
            <IC50 mean="@lf_sensitive_level@" distr="lognormal" CV="0.0"/>
            <slope>4</slope>
          </phenotype>
        </PD>
        <PK>
          <negligible_concentration>0.00032</negligible_concentration>
          <k mean="0.16"/>
          <m_exponent>0</m_exponent>
          <vol_dist mean="21" />
        </PK>
      </drug>
      <drug abbrev="AR_R"><!-- Artemether, one compartment model -->
        <PD>
          <phenotype name="sensitive">
            <restriction onLocus="x" toAllele="sensitive"/>
            <max_killing_rate>@ar_mkr_sensitive@</max_killing_rate>
            <IC50 mean="0.0023" distr="lognormal" CV="0.0"/>
            <slope>4</slope>
          </phenotype>
          <phenotype name="resistant">
            <restriction onLocus="x" toAllele="resistant"/>
            <max_killing_rate>@ar_mkr_resistant@</max_killing_rate>
            <IC50 mean="0.0023" distr="lognormal" CV="0.0"/>
            <slope>4</slope>
          </phenotype>
        </PD>
        <PK>
          <negligible_concentration>1e-17</negligible_concentration>
          <k mean="3.96"/>
          <m_exponent>0.0</m_exponent>
          <vol_dist mean="17.4" />
        </PK>
      </drug>
      <drug abbrev="LF_R"><!-- Lumefantrine -->
        <PD>
          <phenotype name="sensitive">
            <restriction onLocus="x" toAllele="sensitive"/>
            <max_killing_rate>3.45</max_killing_rate>
            <IC50 mean="@lf_sensitive_level@" distr="lognormal" CV="0.0"/>
            <slope>4</slope>
          </phenotype>
          <phenotype name="resistant">
            <restriction onLocus="x" toAllele="resistant"/>
            <max_killing_rate>3.45</max_killing_rate>
            <IC50 mean="@lf_resistance_level@" distr="lognormal" CV="0.0"/>
            <slope>4</slope>
          </phenotype>
        </PD>
        <PK>
          <negligible_concentration>0.00032</negligible_concentration>
          <k mean="0.16"/>
          <m_exponent>0</m_exponent>
          <vol_dist mean="21" />
        </PK>
      </drug>
    </drugs>
  </pharmacology>


